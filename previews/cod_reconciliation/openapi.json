{
  "openapi": "3.0.3",
  "info": {
    "title": "COD Net Reconciliation Preview",
    "version": "0.1.0",
    "description": "Not deployed. Caller-supplied net amount comparison; no bank or carrier verification. Max 1 MB. Provider proxy guard required for deployment; consumer authentication configured by marketplace later."
  },
  "paths": {
    "/v1/cod/reconcile": {
      "post": {
        "operationId": "reconcileCODNetAmounts",
        "summary": "Compare supplied COD net amounts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "orders",
                  "settlements"
                ],
                "properties": {
                  "orders": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "carrier",
                        "tracking_id",
                        "currency",
                        "expected_net"
                      ],
                      "properties": {
                        "carrier": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "\\S"
                        },
                        "tracking_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "\\S"
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        },
                        "expected_net": {
                          "type": "string",
                          "pattern": "^\\d{1,12}(?:\\.\\d{1,6})?$"
                        }
                      }
                    }
                  },
                  "settlements": {
                    "type": "array",
                    "maxItems": 1000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "carrier",
                        "tracking_id",
                        "currency",
                        "settlement_id",
                        "net_received"
                      ],
                      "properties": {
                        "carrier": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "\\S"
                        },
                        "tracking_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "\\S"
                        },
                        "currency": {
                          "type": "string",
                          "pattern": "^[A-Z]{3}$"
                        },
                        "settlement_id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100,
                          "pattern": "\\S"
                        },
                        "net_received": {
                          "type": "string",
                          "pattern": "^-?\\d{1,12}(?:\\.\\d{1,6})?$"
                        }
                      }
                    }
                  },
                  "tolerance": {
                    "type": "string",
                    "default": "0",
                    "pattern": "^(?:0(?:\\.\\d{1,6})?|1(?:\\.0{1,6})?)$"
                  }
                }
              },
              "example": {
                "orders": [
                  {
                    "carrier": "demo",
                    "tracking_id": "A",
                    "currency": "VND",
                    "expected_net": "90000"
                  },
                  {
                    "carrier": "demo",
                    "tracking_id": "B",
                    "currency": "VND",
                    "expected_net": "100000"
                  },
                  {
                    "carrier": "demo",
                    "tracking_id": "C",
                    "currency": "VND",
                    "expected_net": "50000"
                  }
                ],
                "settlements": [
                  {
                    "carrier": "demo",
                    "tracking_id": "A",
                    "currency": "VND",
                    "settlement_id": "S1",
                    "net_received": "60000"
                  },
                  {
                    "carrier": "demo",
                    "tracking_id": "A",
                    "currency": "VND",
                    "settlement_id": "S2",
                    "net_received": "30000"
                  },
                  {
                    "carrier": "demo",
                    "tracking_id": "B",
                    "currency": "VND",
                    "settlement_id": "S3",
                    "net_received": "80000"
                  },
                  {
                    "carrier": "demo",
                    "tracking_id": "D",
                    "currency": "VND",
                    "settlement_id": "S4",
                    "net_received": "20000"
                  }
                ],
                "tolerance": "0"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comparison results; mismatches require review"
          },
          "401": {
            "description": "Unauthorized"
          },
          "413": {
            "description": "Payload exceeds 1 MB"
          },
          "422": {
            "description": "Invalid input"
          },
          "503": {
            "description": "Proxy secret not configured"
          }
        }
      }
    }
  }
}