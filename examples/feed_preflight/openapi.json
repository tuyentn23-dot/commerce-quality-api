{
  "openapi": "3.1.0",
  "info": {
    "title": "Product Feed Preflight API",
    "version": "0.2.0",
    "description": "Bounded pre-import GTIN and exact variant review. Not full feed validation or platform approval."
  },
  "paths": {
    "/v1/products/feed-preflight": {
      "post": {
        "tags": [
          "Product Feed Preflight"
        ],
        "summary": "Feed Preflight",
        "description": "Review up to 500 product rows before import. No assignment or platform approval verification.",
        "operationId": "feed_preflight_v1_products_feed_preflight_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contact": {
        "properties": {
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 254
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Contact"
      },
      "ContactBatch": {
        "properties": {
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Contacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contacts"
        ],
        "title": "ContactBatch"
      },
      "DedupeBatch": {
        "properties": {
          "records": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          },
          "key_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Key Fields"
          },
          "casefold": {
            "type": "boolean",
            "title": "Casefold",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records",
          "key_fields"
        ],
        "title": "DedupeBatch"
      },
      "FeedBatch": {
        "properties": {
          "products": {
            "items": {
              "$ref": "#/components/schemas/ProductRow"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Products"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "products"
        ],
        "title": "FeedBatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceCheck": {
        "properties": {
          "subtotal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Subtotal"
          },
          "tax": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tax",
            "default": "0"
          },
          "shipping": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Shipping",
            "default": "0"
          },
          "discount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Discount",
            "default": "0"
          },
          "total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Total"
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tolerance",
            "default": "0.01"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subtotal",
          "total"
        ],
        "title": "InvoiceCheck"
      },
      "Line": {
        "properties": {
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price"
          },
          "line_total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Line Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "Line"
      },
      "ProductRow": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "gtin": {
            "type": "string",
            "maxLength": 200,
            "title": "Gtin",
            "default": ""
          },
          "gtin_assigned": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gtin Assigned"
          },
          "brand": {
            "type": "string",
            "maxLength": 200,
            "title": "Brand",
            "default": ""
          },
          "mpn": {
            "type": "string",
            "maxLength": 200,
            "title": "Mpn",
            "default": ""
          },
          "country": {
            "type": "string",
            "maxLength": 2,
            "pattern": "^(?:[A-Z]{2})?$",
            "title": "Country",
            "default": ""
          },
          "language": {
            "type": "string",
            "maxLength": 35,
            "pattern": "^(?:[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*)?$",
            "title": "Language",
            "default": ""
          },
          "condition": {
            "type": "string",
            "maxLength": 200,
            "title": "Condition",
            "default": ""
          },
          "multipack": {
            "type": "string",
            "maxLength": 200,
            "title": "Multipack",
            "default": ""
          },
          "color": {
            "type": "string",
            "maxLength": 200,
            "title": "Color",
            "default": ""
          },
          "size": {
            "type": "string",
            "maxLength": 200,
            "title": "Size",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ProductRow"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://commerce-quality-api.onrender.com"
    }
  ]
}