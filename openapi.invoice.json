{
  "openapi": "3.0.3",
  "info": {
    "title": "Invoice Arithmetic Validator",
    "description": "Invoice arithmetic checks, contact syntax normalization, and exact duplicate candidates. No live identity verification. No customer payloads are stored.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/invoices/validate": {
      "post": {
        "tags": [
          "Invoice Arithmetic Validator"
        ],
        "summary": "Validate Invoice",
        "description": "Check arithmetic of supplied values; does not validate tax law or invoice authenticity.",
        "operationId": "validate_invoice_v1_invoices_validate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceCheck"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contact": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string",
            "maxLength": 254,
            "nullable": true
          },
          "phone": {
            "title": "Phone",
            "type": "string",
            "maxLength": 40,
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Contact"
      },
      "ContactBatch": {
        "properties": {
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Contacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contacts"
        ],
        "title": "ContactBatch"
      },
      "DedupeBatch": {
        "properties": {
          "records": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          },
          "key_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Key Fields"
          },
          "casefold": {
            "type": "boolean",
            "title": "Casefold",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records",
          "key_fields"
        ],
        "title": "DedupeBatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceCheck": {
        "properties": {
          "subtotal": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Subtotal"
          },
          "tax": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tax",
            "default": "0"
          },
          "shipping": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Shipping",
            "default": "0"
          },
          "discount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Discount",
            "default": "0"
          },
          "total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Total"
          },
          "tolerance": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Tolerance",
            "default": "0.01"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subtotal",
          "total"
        ],
        "title": "InvoiceCheck"
      },
      "Line": {
        "properties": {
          "quantity": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Quantity"
          },
          "unit_price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Unit Price"
          },
          "line_total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string"
              }
            ],
            "title": "Line Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "Line"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "RapidAPIProxy": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RapidAPI-Proxy-Secret",
        "description": "Provider-side proxy credential. Configure at RapidAPI; consumers use their own RapidAPI key."
      }
    }
  },
  "security": [
    {
      "RapidAPIProxy": []
    }
  ]
}