{
  "openapi": "3.0.3",
  "info": {
    "title": "VN Contact Cleaner",
    "description": "Invoice arithmetic checks, contact syntax normalization, and exact duplicate candidates. No live identity verification. No customer payloads are stored.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/contacts/normalize": {
      "post": {
        "tags": [
          "VN Contact Cleaner"
        ],
        "summary": "Normalize Vietnamese mobile shapes and email syntax",
        "description": "Normalize email domains and Vietnamese mobile shapes, preserving email local-part case.",
        "operationId": "normalizeVNContacts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactBatch"
              },
              "example": {
                "contacts": [
                  {
                    "email": "User@EXAMPLE.COM ",
                    "phone": "+84 912 345 678"
                  },
                  {
                    "email": "bad-email",
                    "phone": "abc"
                  },
                  {}
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {},
                "example": {
                  "count": 3,
                  "results": [
                    {
                      "email": "User@example.com",
                      "email_syntax_valid": true,
                      "phone_e164": "+84912345678",
                      "vn_mobile_shape_valid": true,
                      "scope": "syntax_only",
                      "deliverability_verified": false,
                      "ownership_verified": false
                    },
                    {
                      "email": null,
                      "email_syntax_valid": false,
                      "phone_e164": null,
                      "vn_mobile_shape_valid": false,
                      "scope": "syntax_only",
                      "deliverability_verified": false,
                      "ownership_verified": false
                    },
                    {
                      "email": null,
                      "email_syntax_valid": null,
                      "phone_e164": null,
                      "vn_mobile_shape_valid": null,
                      "scope": "syntax_only",
                      "deliverability_verified": false,
                      "ownership_verified": false
                    }
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Contact": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string",
            "maxLength": 254,
            "nullable": true
          },
          "phone": {
            "title": "Phone",
            "type": "string",
            "maxLength": 40,
            "nullable": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Contact"
      },
      "ContactBatch": {
        "properties": {
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/Contact"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Contacts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "contacts"
        ],
        "title": "ContactBatch"
      },
      "DedupeBatch": {
        "properties": {
          "records": {
            "items": {
              "type": "object"
            },
            "type": "array",
            "maxItems": 500,
            "minItems": 1,
            "title": "Records"
          },
          "key_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 8,
            "minItems": 1,
            "title": "Key Fields"
          },
          "casefold": {
            "type": "boolean",
            "title": "Casefold",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records",
          "key_fields"
        ],
        "title": "DedupeBatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InvoiceCheck": {
        "properties": {
          "subtotal": {
            "title": "Subtotal",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "tax": {
            "title": "Tax",
            "default": "0",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "shipping": {
            "title": "Shipping",
            "default": "0",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "discount": {
            "title": "Discount",
            "default": "0",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "total": {
            "title": "Total",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "tolerance": {
            "title": "Tolerance",
            "default": "0.01",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "type": "array",
            "maxItems": 200,
            "title": "Lines"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subtotal",
          "total"
        ],
        "title": "InvoiceCheck"
      },
      "Line": {
        "properties": {
          "quantity": {
            "title": "Quantity",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "unit_price": {
            "title": "Unit Price",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          },
          "line_total": {
            "title": "Line Total",
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{1,6})?$",
            "example": "1.00"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity",
          "unit_price",
          "line_total"
        ],
        "title": "Line"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://commerce-quality-api.onrender.com"
    }
  ]
}